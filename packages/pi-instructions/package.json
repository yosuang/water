{
  "name": "@yosuang/pi-instructions",
  "version": "0.0.1",
  "description": "Load Water's shared personal instructions into Pi.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions/*/index.ts",
    "instructions",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test extensions/instructions/index.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@yosuang/config": "*",
    "@yosuang/shared": "*"
  },
  "bundledDependencies": [
    "@yosuang/config",
    "@yosuang/shared"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
