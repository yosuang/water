{
  "name": "@yosuang/pi-agent-stuff",
  "version": "0.0.1",
  "description": "Small, general-purpose Pi extensions and skills from Water.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions/*/index.ts",
    "prompts",
    "skills",
    "!**/*.test.*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test extensions/add-dir/index.test.ts extensions/claude-rules/index.test.ts extensions/prompt-stash/index.test.ts skills/handoff-herdr/scripts/send-handoff.test.mjs"
  },
  "pi": {
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@yosuang/shared": "*"
  },
  "bundledDependencies": [
    "@yosuang/shared"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
